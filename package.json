{
  "name": "@muze-labs/solid-apps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build -- --readable && node scripts/serve.mjs",
    "test": "node --import ./scripts/oldm-loader.mjs --test test/*.test.mjs",
    "check": "npm test && npm run build",
    "test:browser": "npm run build && node test/browser.mjs && node test/managed-browser.mjs && node test/picker-browser.mjs && node test/session-browser.mjs && node test/preferences-browser.mjs && node test/workspaces-browser.mjs && node test/provider-browser.mjs",
    "test:picker": "node --test test/capabilities.test.mjs test/launcher-picker.test.mjs && node test/picker-browser.mjs"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "prettier": "^3.6.2",
    "rollup": "^4.67.5"
  },
  "engines": {
    "node": ">=20.6"
  }
}
